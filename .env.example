PORT=3100
QB_RUNTIME_MODE=showcase
QB_BIND_HOST=127.0.0.1
QB_STATIC_ROOT=
QB_HANDOFF_TTL_MS=120000
# Optional free local persistence. Generate a key with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
QB_ENCRYPTED_HANDOFF_PATH=
QB_ENCRYPTION_KEY_BASE64=
# Required only for production mode. Use a different 32+ byte key from the storage key.
QB_AUTH_HMAC_KEY_BASE64=
QB_TRUSTED_HOSTS=
QB_ALLOWED_ORIGINS=
QB_BEDROCK_ENABLED=false
AWS_REGION=ap-south-1
QB_BEDROCK_MODEL_ID=amazon.nova-micro-v1:0
QB_AVP_ENABLED=false
QB_AVP_POLICY_STORE_ID=
# Add AWS credentials through your normal AWS profile or deployment role.
# Never place access keys in this file or commit them.
